# Copy to .env and fill in. Every provider is swappable from here.

# --- Providers ---
LLM_PROVIDER=groq            # groq | google
STT_PROVIDER=moonshine      # moonshine (local CPU, default) | groq (free tier)
TTS_PROVIDER=kokoro          # kokoro (local CPU, default) | groq (Orpheus; accept terms in Groq console first)
AVATAR_MODE=client3d         # client3d (browser 3D) | simli (later) | selfhosted (later)

# --- Keys ---
GROQ_API_KEY=                # free tier: https://console.groq.com/keys
GOOGLE_API_KEY=              # optional, Gemini free tier: https://aistudio.google.com/apikey
SIMLI_API_KEY=               # later
SIMLI_FACE_ID=               # later

# --- Models (optional overrides) ---
# GROQ_LLM_MODEL=openai/gpt-oss-120b
# GROQ_REASONING_EFFORT=low
# GOOGLE_LLM_MODEL=gemini-flash-lite-latest
# GROQ_STT_MODEL=whisper-large-v3-turbo
# MOONSHINE_MODEL=medium-streaming
# KOKORO_PRECISION=int8
# STUN_URL=stun:stun.l.google.com:19302   # set when deployed remotely
# KOKORO_VOICE=af_heart

# --- Agent ---
ENABLED_TOOLS=basics         # comma-separated modules in server/tools/

# --- Deployment (Modal / any public host) ---
# ACCESS_TOKEN=               # required ?key=<token> on the page; set this for any public URL
# STUN_URL=stun:stun.l.google.com:19302
# TURN_URL=turn:standard.relay.metered.ca:443   # optional relay for strict NATs
# TURN_USERNAME=
# TURN_CREDENTIAL=
# WAIT_FOR_ICE_GATHERING=true
