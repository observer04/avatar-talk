# Copy to .env for local development. In the cloud these are Modal Secrets
# (avatar-talk-agent, avatar-talk-api); see infra/modal/README.md.

# --- Shared ---------------------------------------------------------------
ENVIRONMENT=dev                 # dev | staging | prod
LOG_LEVEL=INFO
LOG_FORMAT=console              # console | json

# LiveKit Cloud (media plane): https://cloud.livekit.io
LIVEKIT_URL=wss://<project>.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Service-to-service: the agent calls the API's /internal routes with this token.
API_URL=http://localhost:8000
INTERNAL_API_TOKEN=

# Observability (optional). Langfuse gets traces over OTLP when both keys are set.
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318   # e.g. Jaeger from infra/docker-compose.dev.yml
# OTEL_EXPORTER_OTLP_HEADERS=
# TRACE_CONTENT=true            # include prompts/transcripts in traces (PII)
# SENTRY_DSN=

# --- Agent (services/agent) -----------------------------------------------
DEEPGRAM_API_KEY=               # STT (Flux) and the fallback TTS (Aura-2)
CARTESIA_API_KEY=               # TTS (Sonic-3)
GROQ_API_KEY=                   # default LLM (openai/gpt-oss-120b)
OPENROUTER_API_KEY=             # LLM fallback
OPENAI_API_KEY=                 # LLM fallback
TAVILY_API_KEY=                 # web_search tool
SIMLI_API_KEY=                  # simli avatar backend
# TTS_FALLBACKS=deepgram/aura-2-andromeda-en
# INTERRUPTION_MODE=vad         # vad | adaptive
# INTERRUPTION_MIN_DURATION=0.4
# FLASHHEAD_LAUNCH_URL=         # https://<workspace>--avatar-talk-flashhead-web.modal.run
# FLASHHEAD_READY_TIMEOUT=8     # wait for a warm GPU avatar, then start voice-only
# FLASHHEAD_LATE_JOIN_TIMEOUT=180
# AVATAR_JOIN_TIMEOUT=45        # Simli

# --- API (services/api) ---------------------------------------------------
API_KEYS=                       # comma-separated client keys; empty = no auth (local only)
CORS_ORIGINS=http://localhost:5173
# DATABASE_URL=sqlite+aiosqlite:///.data/api.db   # or postgresql://user:pass@host/db
# STORAGE_BACKEND=local         # local | s3
# S3_BUCKET=
# S3_REGION=
# DAILY_SPEND_CAP_USD=20
# SESSION_TOKEN_TTL_MINUTES=15
# RATE_LIMIT_PER_MINUTE=60

# --- Synthetic caller / scripts -------------------------------------------
# AVATAR_API_KEY=               # one of API_KEYS, for scripts/synthetic_call.py --persona-id
